# ==== Supabase Postgres ====
# Pooler (transaction mode, porta 6543) — usado nas queries da aplicação
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (session mode, porta 5432) — exigida pelo Prisma para migrations
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# ==== Supabase (públicas) ====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=produtos

# ==== Segredos — SÓ no servidor ====
SUPABASE_SERVICE_ROLE_KEY=
# Gere uma string aleatória com pelo menos 32 caracteres, ex:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ==== Usuário inicial (criado pelo prisma/seed.ts) ====
SEED_OWNER_EMAIL=dono@empresa.local
SEED_OWNER_SENHA=troque-esta-senha
SEED_OWNER_NOME="Dono do Negócio"

# ==== Assistente de IA e lançamento em lote — SÓ no servidor ====
# Sem esta chave o sistema funciona normalmente, mas o assistente e o
# lançamento em lote (/produtos/lote) ficam indisponíveis.
OPENAI_API_KEY=
# Modelo: deixe VAZIO. O sistema consulta a OpenAI e usa o mais novo da conta
# (ver src/lib/assistente/modelos.ts). Preencha só para fixar um modelo à força.
OPENAI_ASSISTANT_MODEL=
# Timezone usado para resolver datas relativas ("hoje", "ontem", "dia 15"...)
ASSISTENTE_TIMEZONE=America/Sao_Paulo
# "false" desliga o assistente para todos os usuários
ASSISTENTE_HABILITADO=true
# Limite de mensagens por usuário por dia
ASSISTENTE_LIMITE_DIARIO=200

# ==== Cotador de Fretes (Melhor Envio) — SÓ no servidor ====
# Criar o aplicativo em https://sandbox.melhorenvio.com.br (ou produção) e
# cadastrar a URL de callback exata: <URL_PUBLICA>/api/integracoes/melhor-envio/callback
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=
# "sandbox" ou "production" — nunca misturar tokens dos dois ambientes
MELHOR_ENVIO_ENVIRONMENT=sandbox
# Formato exigido pelo Melhor Envio: "Nome do Sistema (email-tecnico@dominio)"
MELHOR_ENVIO_USER_AGENT="Meu Sistema (seu-email@dominio.com)"
# Escopo mínimo para cotação — nunca solicitar compra/etiqueta/rastreio/cancelamento
MELHOR_ENVIO_SCOPES=shipping-calculate
# Opcional: CEP de origem pré-preenchido no cotador (o usuário pode editar)
MELHOR_ENVIO_CEP_ORIGEM_PADRAO=
# Chave de criptografia dos tokens da integração (AES-256) — gere do mesmo
# jeito que o SESSION_SECRET:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRACOES_TOKEN_KEY=
